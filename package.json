{
    "name": "clipcook",
    "version": "1.0.0",
    "private": true,
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "dev": "next dev --turbopack",
        "build": "node scripts/build-sw.mjs && next build",
        "start": "next start",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "typecheck": "tsc --noEmit",
        "generate:theme": "esbuild scripts/generate-theme.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/generate-theme.cjs --log-level=error && node node_modules/.cache/generate-theme.cjs",
        "generate:icons": "esbuild scripts/generate-icons.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/generate-icons.cjs --log-level=error && node node_modules/.cache/generate-icons.cjs"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@material/material-color-utilities": "^0.4.0",
        "cheerio": "^1.2.0",
        "firebase": "^12.16.0",
        "firebase-admin": "^14.1.0",
        "fraction.js": "^5.3.4",
        "js-quantities": "^1.8.0",
        "motion": "^12.42.2",
        "next": "^16.2.10",
        "parse-iso-duration": "^1.1.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "sass": "^1.101.0",
        "server-only": "^0.0.1",
        "sharp": "^0.35.3",
        "undici": "^8.7.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.3",
        "@material-symbols/svg-400": "^0.45.7",
        "@types/js-quantities": "^1.6.6",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "babel-plugin-react-compiler": "^1.0.0",
        "esbuild": "^0.28.1",
        "serwist": "^9.5.11",
        "typescript": "~6.0.3"
    },
    "overrides": {
        "jose": "^5.10.0"
    },
    "allowScripts": {
        "sharp@0.34.5": true,
        "sharp@0.35.3": true,
        "@firebase/util@1.15.1": true,
        "protobufjs@7.6.5": true,
        "esbuild@0.28.1": true,
        "@parcel/watcher@2.5.6": true
    }
}
