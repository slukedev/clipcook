# --- Backend ---
# firebase | local. Unset: firebase when the FIREBASE_ADMIN_* variables are set,
# otherwise local in development (production refuses to start without one).
# The local backend stores everything in .data/ and signs you in as a demo cook.
CLIPCOOK_BACKEND=
# Where the local backend keeps clipcook.json and its secret (default: ./.data).
CLIPCOOK_DATA_DIR=
# HMAC key for local-backend session cookies (16+ chars). Unset: a random key is
# generated once and kept in .data/secret.
LOCAL_AUTH_SECRET=

# --- Server-only secrets ---
# Firebase Admin service account. Generate a fresh key and paste its JSON content here.
# https://console.cloud.google.com/iam-admin/serviceaccounts
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the full private key with real newlines (wrapped in double quotes), or escape \n
FIREBASE_ADMIN_PRIVATE_KEY=

# Session cookie settings. Keep the name stable or existing sessions break.
SESSION_COOKIE_NAME=clipcook_session
# Session lifetime in seconds. Firebase caps at 14 days (1209600).
SESSION_COOKIE_MAX_AGE=1209600

# --- Links and proxies ---
# Public origin used in display QR codes, bookmarklets, and redirects, e.g.
# https://clipcook.example. Unset: taken from the request's forwarded host.
APP_URL=
# How many reverse proxies append to X-Forwarded-For in front of the app
# (used for per-IP rate limits). On Vercel, x-real-ip is used instead.
TRUST_PROXY_HOPS=1

# --- Development only ---
# 1 lets the clipper fetch localhost and private network addresses, e.g. a recipe
# site running on your machine. Ignored when NODE_ENV is production.
CLIPCOOK_CLIP_ALLOW_PRIVATE=

# --- Public (safe to expose) Firebase web config ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Optional: Google Cast ---
# Registered Cast application id whose receiver URL is <APP_URL>/display/cast.
# Unset: casting is hidden and the cast endpoints answer 404.
NEXT_PUBLIC_CAST_APP_ID=

# --- Optional: updates from slukedev/clipcook ---
# Fine-grained GitHub token with Contents read and write on your copy of the
# repository. Settings > Updates links to a prefilled form.
CLIPCOOK_UPDATE_TOKEN=
# Your copy as owner/name. Vercel provides it; set it on other hosts.
CLIPCOOK_UPDATE_REPO=
# Branch to update. Unset: the repository's default branch.
CLIPCOOK_UPDATE_BRANCH=
# Optional. Who manages updates: a Firebase user ID or a verified email.
# Unset: the first account created on this deployment.
CLIPCOOK_OWNER=
# Optional. When set, the daily update request must send it as a bearer token
# (Vercel Cron does this automatically).
CRON_SECRET=
